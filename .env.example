# Скопируйте в .env.local и заполните. Значения попадают в сборку приложения при npm run build.
# HiveMQ Cloud: Overview -> Connection Details -> WebSocket, порт 8884, путь /mqtt
REACT_APP_MQTT_URL=wss://xxxxxxxx.s1.eu.hivemq.cloud:8884/mqtt
REACT_APP_MQTT_USERNAME=app
REACT_APP_MQTT_PASSWORD=ПАРОЛЬ_ДЛЯ_ПРИЛОЖЕНИЯ
REACT_APP_MQTT_PREFIX=aristokrat

# Адрес бэкенда. По умолчанию — прод на PythonAnywhere. Для локальной разработки: http://127.0.0.1:8000
# REACT_APP_API_URL=http://127.0.0.1:8000
